#!name=AdBlock All-in-One (Test)
#!desc=测试版：保留原模块规则与重写，统一映射 Sr_All_In_One_Pro.js；移除重复脚本映射及 Map Local。仅供 Shadowrocket 设备验证。
[Rule]
# === 1. YouTube / X / Instagram / Google QUIC 回退规则 ===
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,ytimg.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,ggpht.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,google.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,gstatic.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,x.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,twitter.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,twimg.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,instagram.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,cdninstagram.com),(PROTOCOL,UDP)),REJECT

# === 2. 广告与遥测域名拦截 ===
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN,adservice.google.com,REJECT
DOMAIN-SUFFIX,ads.youtube.com,REJECT
DOMAIN,ad.youtube.com,REJECT
DOMAIN,ads-api.x.com,REJECT
DOMAIN,ads-api.twitter.com,REJECT
DOMAIN,ads.twitter.com,REJECT
DOMAIN,analytics.twitter.com,REJECT
DOMAIN,analytics.x.com,REJECT
DOMAIN,scribe.twitter.com,REJECT
DOMAIN,scribe.x.com,REJECT
DOMAIN-SUFFIX,ads-twitter.com,REJECT
DOMAIN-SUFFIX,impression.instagram.com,REJECT
DOMAIN,graph.instagram.com.edgekey.net,REJECT
DOMAIN,ogads-pa.clients6.google.com,REJECT
DOMAIN,firebaselogging-pa.googleapis.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,app-analytics-services.com,REJECT

[URL Rewrite]
# === 3. YouTube 音视频流广告参数处理 ===
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?:\/\/(www|s|m)\.youtube\.com\/(pagead|ptracking|get_midroll_info) _ reject-200
^https?:\/\/(www|s|m)\.youtube\.com\/api\/stats\/(ads|atr|qoe\?.*(adformat|adcontext)=) _ reject-200
^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(ad_break|att\/get|player\/ad_break) _ reject-dict

# === 4. Google 搜索广告链接 ===
^https?:\/\/(www|m)\.google\.[a-z.]+\/(aclk|pagead|ads|adwords|gen_204\?.*ad).* _ reject-200
^https?:\/\/ogs\.google\.[a-z.]+\/widget\/app\/so _ reject-200

# === 5. X 广告接口 ===
^https?:\/\/(api|ads-api)\.(x|twitter)\.com\/[0-9.]+\/(ads|promoted_content|jot\/client_event|onboarding\/sso_init).* _ reject-dict
^https?:\/\/(api|ads-api)\.(x|twitter)\.com\/i\/api\/[0-9.]+\/promoted_content\/.* _ reject-dict
^https?:\/\/x\.com\/i\/commerce\/paywall\/webview\?entrypoint=prewarm _ reject-200

# === 6. Instagram 广告接口 ===
^https?:\/\/(i|graph|www)\.instagram\.com\/api\/v1\/(ads|ad_topics|feed\/injected_reels_media|qp\/batch_fetch|wwwgraphql\/ig\/query\?.*ad).* _ reject-dict
^https?:\/\/graph\.instagram\.com\/logging_client_events _ reject-dict

[Script]
# 唯一主脚本：统一处理 YouTube Protobuf/JSON、X、Instagram、Google 搜索。
SR_All_In_One_Pro = type=http-response,pattern=^https:\/\/(youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?|api\.x\.com\/(graphql\/.+|1\.1\/.+|2\/timeline\/.+)|x\.com\/i\/api\/graphql\/.+|www\.instagram\.com\/(api\/v1\/(feed|discover|clips|stories)\/.+|graphql\/query.*)|www\.google\.com\/search\?.*|m\.google\.com\/search\?.*)$,requires-body=true,max-size=-1,binary-body-mode=1,timeout=10,script-path=https://raw.githubusercontent.com/instarrys-bit/default/main/modules/temp-test/Sr_All_In_One_Pro.js,argument={"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShortsTab":false,"blockShortsFeed":true}

[MITM]
# 仅保留当前原模块已列出的 MITM 主机；不扩大证书拦截范围。
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, m.youtube.com, www.google.com, api.x.com, x.com, m.google.com, ogs.google.com, ads-api.x.com, ads-api.twitter.com, twitter.com, www.instagram.com
