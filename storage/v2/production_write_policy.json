{
  "schema_version": 1,
  "policy_id": "v2-production-write-policy",
  "default": "DENY",
  "protected_paths": [
    {
      "path": "modules/uu.conf",
      "scope": "AUTOMATED_WORKFLOWS_AND_AUTOMATION_IDENTITIES_ONLY",
      "access": "READ_ONLY_FOR_AUTOMATION",
      "reason": "User-managed configuration. Automated workflows may read but must not write, replace, regenerate, reformat, rename or delete it. The user retains unrestricted manual edit authority through normal human-controlled repository access."
    }
  ],
  "actors": {
    "dashboard": {
      "read": [
        "storage-management-projections",
        "verified-audit-artifacts"
      ],
      "write": []
    },
    "watchdog": {
      "read": [
        "storage-management-api"
      ],
      "write": [
        "storage-management-api:dispatch-intent",
        "storage-management-api:recovery-request"
      ]
    },
    "production_workers": {
      "read": [
        "approved-input-artifacts",
        "staging-artifacts"
      ],
      "write": [
        "storage-management-api:artifact.stage",
        "storage-management-api:release.prepare"
      ]
    },
    "storage_management": {
      "read": [
        "authorized-storage-and-release-scopes"
      ],
      "write": [
        "storage/v2/state.json",
        "storage/v2/artifacts/sha256/{sha256}",
        "storage/v2/migration/manifests/{manifest_sha256}.json",
        "storage/v2/projections/{projection_name}.json",
        "storage/v2/releases/{release_sha256}.json",
        "rulesets/direct.list",
        "rulesets/proxy.list",
        "rulesets/reject.list",
        "rulesets/manifest.json",
        "rulesets/lifecycle_state.json",
        "rulesets/lifecycle_observations.json",
        "automation/release_manifest.json",
        "storage/v2/state/manifest.json",
        "storage/v2/state/segments/*.jsonl"
      ]
    },
    "independent_verifier": {
      "read": [
        "published-ruleset-outputs",
        "release-records"
      ],
      "write": [
        "storage-management-api:verification-report"
      ]
    },
    "human_user": {
      "read": [
        "repository"
      ],
      "write": [
        "repository"
      ],
      "note": "Manual user changes, including modules/uu.conf, are permitted subject only to the repository's normal human access controls. Automation-only restrictions do not apply to this actor."
    }
  },
  "publication_exact_paths": [
    "rulesets/direct.list",
    "rulesets/proxy.list",
    "rulesets/reject.list"
  ],
  "publication_metadata_exact_paths": [
    "rulesets/manifest.json",
    "rulesets/lifecycle_state.json",
    "rulesets/lifecycle_observations.json",
    "automation/release_manifest.json"
  ],
  "forbidden_patterns": [
    "modules/**",
    "storage/v2/queue_seed.json",
    "storage/v2/production_write_policy.json",
    "automation/task_queue.json",
    "automation/production_control.json",
    "automation/production_inputs.json",
    "scripts/**",
    ".github/workflows/**",
    "data/**",
    "sources/**",
    "reports/**",
    "tests/**"
  ],
  "enforcement": {
    "exact_path_match_only": true,
    "wildcard_write_grants": false,
    "expected_sha_required": true,
    "idempotency_key_required": true,
    "fencing_token_required_for_leased_resources": true,
    "independent_readback_required": true,
    "reject_unknown_paths": true,
    "protection_scope": "automation_identities_only",
    "manual_user_edits_allowed": true,
    "template_path_regex_validation": true,
    "automation_role_scope_required": true,
    "human_manual_edits_bypass_automation_only_policy": true
  }
}
